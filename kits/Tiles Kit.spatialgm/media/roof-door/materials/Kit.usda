#usda 1.0
(
    defaultPrim = "Looks"
    metersPerUnit = 1.524
    upAxis = "Z"
)

def Xform "Looks"
{
    def Material "Timber"
    {
        token outputs:surface.connect = </Looks/Timber/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.25, 0.105, 0.037)
            float inputs:metallic = 0
            float inputs:roughness = 0.76
            token outputs:surface
        }
    }

    def Material "Board"
    {
        token outputs:surface.connect = </Looks/Board/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
