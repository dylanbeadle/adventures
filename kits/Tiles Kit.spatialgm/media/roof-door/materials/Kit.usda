        token outputs:surface.connect = </Looks/Iron/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.055, 0.065, 0.07)
